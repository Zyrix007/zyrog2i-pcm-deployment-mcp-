# ZyroG2i Persistent Context Manager (PCM) Deployment MCP Configuration
# Copy this file to .env or pass these variables in your MCP host configuration.

# Per-user application data directory (SQLite database pcm.sqlite is stored here)
PCM_DATA_DIR=/var/tmp/pcm-data

# Server-enforced namespace authority (caller-supplied namespaces are never trusted)
PCM_NAMESPACE=default

# Controlled root directory for local artifact references (path traversal/symlinks outside are rejected)
PCM_ARTIFACT_ROOT=/var/tmp/pcm-data/artifacts

# Controlled directory for consistent namespace-scoped JSON snapshot exports
PCM_EXPORT_DIR=/var/tmp/pcm-data/exports

# Diagnostic stderr logging level: debug | info | warn | error | silent (stdout is strictly protocol-only)
PCM_LOG_LEVEL=info
